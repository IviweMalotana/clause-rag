# ----------------------------------------------------------------------------
# Clause — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# --- Database (Postgres + pgvector) ---
# Local dev (docker-compose) default. On Railway, use the provided DATABASE_URL.
DATABASE_URL=postgresql+psycopg://clause:clause@localhost:5432/clause

# --- Anthropic (answer generation) ---
# Required to generate live answers. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- OpenAI (embeddings only) ---
# Required to build the vector index during ingestion/seed.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Retrieval / guardrail tuning ---
# Min cosine similarity for a chunk to count as supporting evidence.
# Answers below this threshold trigger the "corpus does not support" guardrail.
RETRIEVAL_MIN_SCORE=0.30
RETRIEVAL_TOP_K=6

# --- API / app ---
# Comma-separated list of allowed CORS origins for the web app.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000

# --- Web (Next.js) ---
# Base URL the browser/SSR uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
