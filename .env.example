# ----------------------------------------------------------------------------
# Clause — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ----------------------------------------------------------------------------

# --- Database (Postgres + pgvector) ---
# Local dev (docker-compose) default. On Railway, use the provided DATABASE_URL.
DATABASE_URL=postgresql+psycopg://clause:clause@localhost:5432/clause

# --- Anthropic (answer generation) ---
# Required to generate live answers. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default is the cheapest current Claude (Haiku 4.5).
# Upgrade for better answers: claude-sonnet-4-6 or claude-opus-4-8.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- OpenAI (embeddings only) ---
# Required to build the vector index during ingestion/seed.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Retrieval / guardrail tuning ---
# Optional override of the cosine-similarity floor for supporting evidence.
# Leave unset to use the embedder's calibrated default (hashed vs OpenAI differ).
# RETRIEVAL_MIN_SCORE=0.24
RETRIEVAL_TOP_K=6

# --- API / app ---
# Comma-separated list of allowed CORS origins for the web app.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
API_PORT=8000

# Optional: set to require an X-Clause-Token header for write actions (ingest).
# Leave unset for a fully open demo. When set, the web's ingest view prompts
# users to paste the token once; it's stored only in their browser.
# DEMO_WRITE_TOKEN=change-me

# --- Web (Next.js) ---
# Base URL the browser/SSR uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
